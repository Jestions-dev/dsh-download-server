{
  "name": "dsh-dl-server",
  "version": "0.2.0",
  "description": "DLS — DSH Download Server: a global, session-aware, persistent download queue for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "download",
    "downloader",
    "queue",
    "aria2",
    "dls"
  ],
  "author": "Jestions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jestions-dev/dsh-download-server.git"
  },
  "homepage": "https://github.com/Jestions-dev/dsh-download-server#readme",
  "bugs": {
    "url": "https://github.com/Jestions-dev/dsh-download-server/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/index.js && node --check lib/domain.js && node --check lib/types.js"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-storage-domain": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-storage-domain": "^0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
